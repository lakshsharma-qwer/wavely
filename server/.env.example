PORT=4000

# Music source. By default the server joins a beatsync.gg room over its public
# WebSocket to search and load songs (no extra setup needed).
BEATSYNC_WS_URL=wss://server.beatsync.gg/ws
BEATSYNC_CONNECTIONS=3

# Optional: direct Beatsync provider API, if Beatsync issues you one. Takes priority over the WebSocket.
PROVIDER_URL=
PROVIDER_API_KEY=

# true = offline sample tracks for development
DEMO_MODE=false

# Home page rows: "Title:search query" pairs separated by |
HOME_SECTIONS=Trending now:top hits|Chill vibes:chill|Workout energy:workout|Hip-hop essentials:hip hop|Indie picks:indie|Throwbacks:90s hits

RATE_LIMIT_PER_MINUTE=120
# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=
